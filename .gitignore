# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/
logs/
.pm2/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
__pycache__/
*.py[cod]

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ide
.idea
application-system/outputs/*
!application-system/outputs/.gitkeep
public/generated-cv-data/*
!public/generated-cv-data/.gitkeep

# SOP runtime artifacts; durable state and its Markdown mirror remain tracked
governance/.sop/state.lock
governance/.sop/run_logs/
