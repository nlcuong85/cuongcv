{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Digital Twin Evidence Library",
  "type": "object",
  "required": ["evidence"],
  "properties": {
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "claim", "source"],
        "properties": {
          "id": {"type": "string"},
          "type": {
            "type": "string",
            "enum": ["work", "project", "education", "certificate", "portfolio", "writing_sample", "reference", "user_statement"]
          },
          "claim": {"type": "string"},
          "source": {"type": "string"},
          "date": {"type": "string"},
          "strength": {
            "type": "string",
            "enum": ["strong", "medium", "weak"]
          },
          "notes": {"type": "string"},
          "usable_for": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["application", "academic", "work", "social", "personal"]
            }
          }
        }
      }
    }
  }
}
