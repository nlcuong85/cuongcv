{
  "name": "application-package-mcp",
  "version": "0.2.23",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --http",
    "start:stdio": "node dist/index.js --stdio",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:browser": "playwright test --config qa/automation/playwright/playwright.config.mjs",
    "test:browser:ui": "playwright test --config qa/automation/playwright/playwright.config.mjs --ui",
    "test:onboarding-workspace": "node scripts/check_onboarding_workspace.mjs",
    "smoke:remote": "node tests/smoke-remote.mjs",
    "sample:generate": "python3 samples/local-kit-regression/run_regression.py",
    "ats:benchmark": "node scripts/run_ats_benchmark.mjs",
    "ats:benchmark:second": "node scripts/run_ats_benchmark_second_batch.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  }
}
